# This project splits its environment variables across two files, because
# the Prisma CLI only ever auto-loads `.env` (never `.env.local`), while
# Next.js loads both (with `.env.local` taking precedence on overlaps).
# Keeping DATABASE_URL/DIRECT_URL in exactly one file avoids the two ever
# drifting out of sync.

# =====================================================================
# Copy the block below into a new `.env` file (used by Prisma CLI + app).
# =====================================================================

# Get these from Supabase Dashboard -> Project Settings -> Database ->
# Connection string. Supabase's *direct* connection (db.<ref>.supabase.co)
# is IPv6-only — on an IPv4-only network (most local/office/CI networks)
# it will hang and Prisma will throw "Can't reach database server". Use the
# pooler (Supavisor) for both variables instead:
#
# DATABASE_URL -> Transaction pooler, port 6543. Used by Prisma Client at
#   runtime. Requires `pgbouncer=true` (transaction-mode pooling doesn't
#   support prepared statements) and a small `connection_limit`.
# DIRECT_URL   -> Session pooler, same host, port 5432. Used only by
#   `prisma migrate`/`db push`, which need a stable session — the
#   transaction pooler is not suitable for schema changes.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-<region>.pooler.supabase.com:5432/postgres"

# ============================================================
# Copy the block below into a new `.env.local` file (app-only).
# ============================================================

# --- Supabase Auth ---
# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never expose to the browser.
# Required for admin-only actions (e.g. syncing a user's role into
# Supabase user_metadata).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public site URL, used to build absolute redirect URLs for Supabase auth emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudinary ---
# From cloudinary.com/console (Dashboard home). Server-only — used to sign
# direct browser-to-Cloudinary uploads and to delete assets; never exposed
# to the client.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
